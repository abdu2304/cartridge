{
 "schema": 1,
 "id": "uncharted",
 "name": "Uncharted: The Nathan Drake Collection",
 "by": "Supermedo (Mohammed Albarghouthi), on bbport and shadPS4’s renderer",
 "repo": "github:Supermedo/uncharted_pc",
 "licence": "GPL-2.0-or-later",
 "about": "Uncharted 1, 2 and 3 from the PS4 collection, with the original game code running natively and the graphics translated to Vulkan. 60 or 120 FPS, TAA, FSR or DLSS and frame generation.",
 "verified": {
  "on": "2026-10-17",
  "release": "v0.3.3",
  "played": false
 },
 "game": {
  "console": "ps4",
  "title": "Uncharted: The Nathan Drake Collection",
  "ids": [
   "CUSA02343",
   "CUSA02320"
  ],
  "kind": "folder",
  "has": [
   "eboot.bin",
   "sce_sys/param.sfo"
  ],
  "why": "The collection’s folder holds all three games (eboot.bin, big2-ps4_Shipping.elf and big3-ps4_Shipping.elf)."
 },
 "builds": [
  {
   "os": "windows",
   "asset": "^uncharted-windows\\.zip$",
   "program": "Uncharted.exe",
   "args": [
    "--play"
   ],
   "files": {
    "app": {
     "path": "{appdata}/uncharted-launcher/settings.json",
     "format": "json"
    },
    "ini": {
     "path": "{dir}/bbport.ini",
     "format": "flat"
    }
   }
  }
 ],
 "app": {
  "game_dir": "{game}",
  "check_updates": false,
  "close_on_play": true
 },
 "play": [
  {
   "id": "u1",
   "name": "Uncharted 1: Drake's Fortune",
   "sub": "Uncharted 1 · 2007",
   "needs": "eboot.bin",
   "app": {
    "start": "u1"
   }
  },
  {
   "id": "u2",
   "name": "Uncharted 2: Among Thieves",
   "sub": "Uncharted 2 · 2009",
   "needs": "big2-ps4_Shipping.elf",
   "app": {
    "start": "u2"
   }
  },
  {
   "id": "u3",
   "name": "Uncharted 3: Drake's Deception",
   "sub": "Uncharted 3 · 2011",
   "needs": "big3-ps4_Shipping.elf",
   "app": {
    "start": "u3"
   }
  }
 ],
 "keep": [
  "user",
  "out",
  "art",
  "bbport.ini",
  "input.ini",
  "last_run.log"
 ],
 "saves": [
  "{dir}/user/savedata"
 ],
 "settings": [
  {
   "id": "frame_rate",
   "tab": "Display",
   "label": "Frame rate",
   "type": "choice",
   "def": "60",
   "at": [
    "app",
    "frame_rate"
   ],
   "options": [
    [
     "60",
     "60 FPS (as on PS4)"
    ],
    [
     "120",
     "120 FPS"
    ],
    [
     "144",
     "144 FPS (experimental)"
    ],
    [
     "165",
     "165 FPS (experimental)"
    ],
    [
     "240",
     "240 FPS (experimental)"
    ]
   ],
   "desc": "The games time gameplay with the real clock; cutscenes keep 60 FPS at every setting."
  },
  {
   "id": "fullscreen",
   "tab": "Display",
   "label": "Fullscreen",
   "type": "bool",
   "def": false,
   "at": [
    "app",
    "fullscreen"
   ]
  },
