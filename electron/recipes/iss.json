   "type": "bool",
   "def": false,
   "at": [
    "app",
    "eager_readback"
   ],
   "desc": "On made smoke and glow flicker in precise mode."
  },
  {
   "id": "write_merge",
   "tab": "Advanced",
   "label": "Write into GPU memory without waiting",
   "type": "bool",
   "def": true,
   "at": [
    "app",
    "write_merge"
   ]
  },
  {
   "id": "deferred_readback",
   "tab": "Advanced",
   "label": "The game waits for its own GPU reads",
   "type": "bool",
   "def": true,
   "at": [
    "app",
    "deferred_readback"
   ]
  }
 ],
