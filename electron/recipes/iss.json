   "type": "number",
   "def": 10,
   "at": [
    "app",
    "stick_deadzone"
   ],
   "num": {
    "min": 0,
    "max": 50,
    "unit": "%"
   }
  },
  {
   "id": "vram_budget_mb",
   "tab": "Performance",
   "label": "Video memory budget",
