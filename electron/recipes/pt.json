{
 "schema": 1,
 "id": "pt",
 "name": "P.T.",
 "by": "LoreanXavier (Hallway Engine)",
 "repo": "github:LoreanXavier/pt-pc",
 "licence": "MIT",
 "about": "A native PC port of the 2014 teaser, rebuilt in C++ on its own engine, reading every level, sound and cutscene from your copy. The whole teaser, voice part included, with photo mode, upscalers and ray-traced extras.",
 "verified": {
  "on": "2026-10-17",
  "release": "v1.0.5",
  "played": false
 },
 "game": {
  "console": "ps4",
  "title": "P.T.",
  "ids": [
   "CUSA01127",
   "CUSA01114",
   "CUSA01098"
  ],
  "kind": "folder-or-pkg",
  "has": [],
  "why": "The US release CUSA01127 is the tested one; the European and Japanese ones install with a note. The port finds chunk1.psarc and texture.qar beside eboot.bin, or in a folder inside the one you pick.",
  "find": {
   "files": [
    "chunk1.psarc",
    "texture.qar"
   ],
   "depth": 2
  }
 },
 "builds": [
  {
   "os": "linux",
   "asset": "^P\\.T\\.PC\\.Port\\.Setup-linux$",
   "installer": [
    "--install",
    "{game}",
    "{dir}/game",
    "{result}"
   ],
   "program": "game/pt",
   "args": [],
   "files": {
    "ini": {
     "path": "{dir}/game/data/pt.ini",
     "format": "ini"
    }
   }
  }
 ],
 "keep": [
  "game"
 ],
 "saves": [
  "{dir}/game/data/PT_Save_Data0",
  "{dir}/game/data/PT_Save_Data1"
 ],
 "settings": [
  {
   "id": "fullscreen",
   "tab": "Display",
   "label": "Window",
   "type": "choice",
   "def": "0",
   "at": [
    "ini",
    [
     "display",
     "fullscreen"
    ]
   ],
   "options": [
    [
     "0",
     "Window"
