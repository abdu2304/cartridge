  },
  {
   "id": "mirror",
   "tab": "Gameplay",
   "label": "Mirror and reflection updates",
   "type": "choice",
   "at": [
    "ini",
    "mirror"
   ],
   "options": [
    [
     "0",
     "Live"
    ],
    [
     "1",
     "Static (faster)"
    ]
   ],
   "desc": "Static draws mirrors, rain and reflections once: much faster, but they stop updating.",
   "def": "0"
  },
  {
   "id": "full",
   "tab": "Gameplay",
   "label": "Fullscreen",
   "type": "bool",
   "at": [
    "ini",
    "full"
   ],
   "def": true
  },
  {
   "id": "dlc",
   "tab": "Gameplay",
   "label": "Unlock DLC content",
   "type": "bool",
   "at": [
    "ini",
    "dlc_unlock"
   ],
   "desc": "Add-on cars, bikes, tours and livery decals, built from your own game files. Your game folders aren’t changed.",
   "def": false
  },
  {
   "id": "fps",
   "tab": "Gameplay",
   "label": "Show the FPS counter",
   "type": "bool",
   "at": [
    "ini",
    "fps"
   ],
   "def": false
  },
  {
   "id": "blur",
   "tab": "Patches",
   "label": "Disable motion blur and depth of field",
   "type": "bool",
   "at": [
    "list",
    "Disable motion blur and depth of field"
   ],
   "desc": "Leave it off with FSR or DLAA anti-aliasing: they need the game’s blur pass.",
   "def": false
  },
  {
   "id": "reset",
   "tab": "Patches",
   "label": "No reset-to-track timer",
   "type": "bool",
   "at": [
