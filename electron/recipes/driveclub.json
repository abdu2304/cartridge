 ],
 "saves": [
  "{dir}/data/user/savedata"
 ],
 "achievements": {
  "files": [
   "{dir}/logs/driveclub_*.log"
  ],
  "why": "runtime_services.c prints Runtime: trophy N unlocked into the log of each start; names from your copy’s trophy file when a shadPS4 trophy key is set up"
 },
