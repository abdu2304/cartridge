{
 "schema": 1,
 "id": "unleashed",
 "name": "Unleashed Recompiled",
 "by": "hedge-dev (Sajid, Skyth, Hyper, Darío and others)",
 "repo": "github:hedge-dev/UnleashedRecomp",
 "licence": "GPL-3.0",
 "about": "The Xbox 360 Sonic Unleashed, statically recompiled for PC: high frame rates, ultrawide, higher resolutions, improved shadows and effects, achievements. Its own window installs the game the first time from your copy, its title update and any DLC.",
 "verified": {
  "on": "2026-10-20",
  "release": "v1.0.3",
  "played": false
 },
 "game": {
  "console": "xbox360",
  "title": "Sonic Unleashed",
  "kind": "file",
  "ext": [
   ".iso",
   ".xex",
   ".zar"
  ],
  "why": "Your own Xbox 360 copy of Sonic Unleashed (a disc image or its extracted folder), and its title update."
 },
 "builds": [
  {
   "os": "linux",
   "asset": "^UnleashedRecomp-Flatpak\\.zip$",
   "program": "UnleashedRecomp",
   "args": [
    "run",
    "io.github.hedge_dev.unleashedrecomp"
   ],
   "files": {
    "ini": {
     "path": "{home}/.config/UnleashedRecomp/config.toml",
     "format": "ini"
    }
   }
  },
  {
   "os": "windows",
   "asset": "^UnleashedRecomp-Windows\\.zip$",
   "program": "UnleashedRecomp.exe",
   "args": [],
   "files": {
    "ini": {
     "path": "{appdata}/UnleashedRecomp/config.toml",
     "format": "ini"
    }
   }
  }
 ],
 "setup": {
  "by": "port",
  "done": [
   "{home}/.var/app/io.github.hedge_dev.unleashedrecomp/data/patched/default.xex",
   "{dir}/patched/default.xex"
  ],
  "say": "Unleashed Recompiled installs the game in its own window the first time: choose Add Files or Add Folder for your copy, then add its title update and any DLC, and install. After that Cartridge starts it straight away."
 },
