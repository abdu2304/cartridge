{
 "schema": 1,
 "id": "gow3",
 "name": "God of War III Remastered",
 "by": "FelipePrado0, on bbport and shadPS4",
 "repo": "github:FelipePrado0/gow3_pc",
 "licence": "GPL-2.0-or-later",
 "about": "The PS4 remaster running natively, with its patches applied automatically: the texture fix, skippable videos and 120 FPS on by default, render resolution and engine frame rate.",
 "verified": {
  "on": "2026-10-17",
  "release": "windows-v2.4.1",
  "played": false
 },
 "game": {
  "console": "ps4",
  "title": "God of War III Remastered",
  "ids": [
   "CUSA01623",
   "CUSA01715"
  ],
  "kind": "folder",
  "has": [
   "eboot.bin",
   "sce_sys/param.sfo",
   "sce_module/libc.prx",
   "sce_module/libSceFios2.prx"
  ],
  "why": "Tested with CUSA01623 and CUSA01715, versions 01.00 and 01.02.",
  "tested": [
   "01.00",
   "01.02"
  ]
 },
 "builds": [
  {
   "os": "linux",
   "asset": "^gow3-x86_64\\.AppImage$",
   "program": "gow3-x86_64.AppImage",
   "args": [
    "--play"
   ],
   "note": "The Linux build is marked experimental by its author; Steam Deck rendering problems were reported in older AppImages.",
   "files": {
    "app": {
     "path": "{config}/gow3-launcher/settings.json",
     "format": "json"
    },
    "ini": {
     "path": "{data}/gow3/gow3.ini",
     "format": "flat"
    }
   }
  },
  {
   "os": "windows",
   "asset": "^gow3-windows\\.zip$",
   "program": "God of War III.exe",
   "args": [
    "--play"
   ],
   "files": {
    "app": {
     "path": "{appdata}/gow3-launcher/settings.json",
     "format": "json"
    },
    "ini": {
     "path": "{dir}/gow3.ini",
     "format": "flat"
    }
   }
  }
 ],
 "app": {
  "game_dir": "{game}",
  "check_updates": false,
  "close_on_play": true
 },
 "keep": [
  "user",
  "out",
  "mods",
  "gow3.ini",
  "mods.json",
  "mods_presets.json",
  "patches.json",
  "last_run.log"
 ],
 "saves": {
  "linux": [
   "{data}/gow3/user/savedata"
  ],
  "windows": [
   "{dir}/user/savedata"
  ]
 },
 "shadps4Saves": "CUSA01623",
 "settings": [
