{
 "schema": 1,
 "id": "strikers",
 "name": "Super Mario Strikers (PC)",
 "by": "new-coke, from the game’s decompiled code",
 "repo": "github:new-coke/strikers",
 "licence": "GPL-3.0",
 "about": "Super Mario Strikers rebuilt from decompiled code (not an emulator): high frame rates, higher resolutions, 4x MSAA, 16x filtering, any controller. Plays straight from your own disc image (ISO, GCM, CISO or GCZ): US, European or Japanese.",
 "verified": {
  "on": "2026-10-20",
  "release": "v1.3.0",
  "played": false
 },
 "game": {
  "console": "gamecube",
  "title": "Super Mario Strikers",
  "also": [
   "Mario Smash Football"
  ],
  "ids": [
   "G4QE01",
   "G4QP01",
   "G4QJ01"
  ],
  "kind": "file",
  "ext": [
   ".iso",
   ".gcm",
   ".ciso",
   ".gcz",
   ".nkit.iso"
  ],
  "why": "Your own Super Mario Strikers (or Mario Smash Football) disc image: US, European or Japanese."
 },
 "builds": [
  {
   "os": "linux",
   "asset": "^strikers-linux-x86_64\\.tar\\.gz$",
   "program": "strikers",
   "args": [],
   "files": {
    "ini": {
     "path": "{dir}/strikers.ini",
     "format": "flat",
     "sparse": true
    }
   }
  }
 ],
 "ini": {
  "data": "{game}"
 },
 "settings": [
  {
   "id": "res_scale",
   "tab": "Display",
   "label": "Internal resolution",
   "type": "number",
   "at": [
    "ini",
    "res_scale"
   ],
   "num": {
    "min": 1,
    "max": 6,
    "unit": "x"
   },
   "desc": "A multiple of the console’s 448 rows. Left alone it follows the window (the panel’s 800 rows on a Steam Deck).",
   "def": 2
  },
  {
   "id": "msaa",
   "tab": "Display",
   "label": "Multisampling",
   "type": "choice",
   "at": [
    "ini",
    "msaa"
   ],
   "options": [
    [
     "1",
     "Off"
    ],
    [
     "4",
     "4x"
    ]
   ],
   "def": "1"
  },
  {
   "id": "aniso",
   "tab": "Display",
   "label": "Anisotropic filtering",
   "type": "choice",
   "at": [
    "ini",
    "aniso"
   ],
   "options": [
    [
     "1",
     "Off"
    ],
    [
     "2",
     "2x"
    ],
    [
     "4",
     "4x"
    ],
    [
     "8",
     "8x"
    ],
    [
     "16",
     "16x"
    ]
   ],
   "def": "16"
  },
  {
   "id": "fps_limit",
   "tab": "Display",
   "label": "Frame rate cap",
   "type": "number",
   "at": [
    "ini",
    "fps_limit"
   ],
   "num": {
    "min": 0,
    "max": 500,
    "unit": "FPS"
   },
   "desc": "0 for unlimited. 40 on a Steam Deck saves battery.",
   "def": 59.94
  },
  {
   "id": "vsync",
   "tab": "Display",
   "label": "VSync",
   "type": "bool",
   "at": [
    "ini",
    "vsync"
   ],
   "desc": "On gives the steadiest picture; off is more responsive and keeps the frame rate up.",
   "def": true
  },
  {
   "id": "aspect",
   "tab": "Display",
   "label": "Aspect ratio",
   "type": "choice",
   "at": [
    "ini",
    "aspect"
   ],
   "options": [
    [
     "auto",
     "Automatic"
    ],
    [
     "16:9",
     "16:9"
    ],
    [
     "4:3",
     "4:3"
    ],
    [
     "21:9",
     "21:9"
    ]
   ],
   "def": "auto"
  },
  {
   "id": "fullscreen",
