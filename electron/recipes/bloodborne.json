{
 "schema": 1,
 "id": "bloodborne",
 "name": "Bloodborne",
 "by": "Supermedo (Mohammed Albarghouthi), on deadinside28’s bbport",
 "repo": "github:Supermedo/bloodborne_pc",
 "licence": "GPL-2.0-or-later",
 "about": "The PlayStation 4 game’s own code runs natively on the PC and its graphics are translated to Vulkan. Upscaling, unlocked frame rates, effects on and off, cheats and gameplay tweaks.",
 "verified": {
  "on": "2026-10-17",
  "release": "windows-v1.9",
  "played": false
 },
 "game": {
  "console": "ps4",
  "title": "Bloodborne",
  "ids": [
   "CUSA03173"
  ],
  "kind": "folder",
  "has": [
   "eboot.bin",
   "sce_sys/param.sfo"
  ],
  "version": {
   "want": "01.09",
   "soft": true,
   "why": "Version 1.09 is needed for the 60, 90 and unlocked frame rates, the resolution and the effect switches. Other versions run at 30 FPS."
  },
  "dlc": "The Game of the Year edition already has The Old Hunters."
 },
 "builds": [
  {
   "os": "windows",
   "asset": "^bloodborne-windows\\.zip$",
   "program": "Bloodborne.exe",
   "args": [
    "--play"
   ],
   "files": {
    "app": {
     "path": "{appdata}/bbport-launcher/settings.json",
     "format": "json"
    },
    "ini": {
     "path": "{dir}/bbport.ini",
     "format": "flat"
    }
   }
  }
 ],
 "app": {
  "game_dir": "{game}",
  "check_updates": false,
  "close_on_play": true
 },
 "keep": [
  "user",
  "out",
  "mods",
  "bbport.ini",
  "input.ini",
  "mods.json",
  "patches.json",
  "last_run.log"
 ],
 "saves": [
  "{dir}/user/savedata"
 ],
 "shadps4Saves": "CUSA03173",
 "settings": [
  {
   "id": "fps_mode",
   "tab": "Display",
   "label": "Frame rate",
   "type": "choice",
   "def": "uncap",
   "at": [
    "app",
    "fps_mode"
   ],
   "options": [
    [
     "uncap",
     "Unlocked (frame-time patch)"
    ],
    [
     "60",
     "60 FPS"
    ],
    [
     "90",
     "90 FPS"
    ],
    [
     "30",
     "30 FPS (as on PS4)"
    ]
   ]
  },
  {
   "id": "frame_cap",
   "tab": "Display",
   "label": "Frame cap (unlocked mode)",
   "type": "choice",
   "def": "",
   "at": [
    "app",
    "frame_cap"
   ],
   "options": [
    [
     "",
     "Auto: display refresh, max 120 (recommended)"
    ],
    [
     "60",
     "60"
    ],
    [
     "90",
     "90"
    ],
    [
     "120",
     "120"
    ],
    [
     "144",
     "144 (risky)"
    ],
    [
     "165",
     "165 (risky)"
    ],
    [
     "240",
     "240 (risky)"
    ],
    [
     "0",
     "No limit (risky)"
    ]
   ],
   "desc": "The game’s movement timing breaks above about 120 FPS."
  },
  {
