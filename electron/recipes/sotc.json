{
 "schema": 1,
 "id": "sotc",
 "name": "Shadow of the Colossus",
 "by": "AjncSystem and the community (Lucas-blip-png, Gabriell-os, Oussama268 and others), on the bbport loader",
 "repo": "github:AjncSystem/ShadowOfTheColossus-PC",
 "licence": "GPL-2.0",
 "about": "The PS4 Shadow of the Colossus (Bluepoint, 2018) running natively: the game’s own code on your CPU, its graphics translated to Vulkan. 60 FPS and up, outputs to 4K and ultrawide, PS4 Pro mode, water reflections, mouse camera. Sound needs two modules from your own PS4, which Cartridge finds in shadPS4’s sys_modules.",
 "verified": {
  "on": "2026-10-20",
  "release": "v0.59",
  "played": false
 },
 "game": {
  "console": "ps4",
  "title": "Shadow of the Colossus",
  "ids": [
   "CUSA08809"
  ],
  "kind": "folder",
  "has": [
   "eboot.bin",
   "sce_sys/param.sfo"
  ],
  "version": {
   "want": "01.01",
   "soft": true,
   "why": "It is made for the EU 1.01 copy (CUSA08809): the 60 FPS and 16x filtering patches need it; other copies run at 30 FPS."
  }
 },
 "builds": [
  {
   "os": "windows",
   "asset": "^SotC-PC\\.zip$",
   "program": "SotC.exe",
   "args": [
    "--play"
   ],
   "files": {
    "app": {
     "path": "{appdata}/sotc-launcher/settings.json",
     "format": "json"
    }
   }
  }
 ],
 "look": [
  {
   "var": "sysmods",
   "files": [
    "libSceNgs2.sprx",
    "libSceUlt.sprx"
   ],
   "dirs": [
    "{data}/shadPS4/sys_modules",
    "{home}/.var/app/net.shadps4.shadPS4/data/shadPS4/sys_modules",
    "{config}/shadPS4/sys_modules",
    "{dir}/user/sys_modules",
    "{dir}/sys_modules"
   ],
   "why": "libSceNgs2.sprx and libSceUlt.sprx from your own PS4, for sound"
  }
 ],
 "app": {
  "game_dir": "{game}",
  "sys_modules": "{sysmods}",
  "check_updates": false,
  "close_on_play": true,
  "auto_setup": false
 },
 "settings": [
  {
   "id": "fps_mode",
   "tab": "Graphics",
   "label": "Frame rate",
   "type": "choice",
   "def": "30",
   "at": [
    "app",
    "fps_mode"
   ],
   "options": [
    [
     "30",
     "30 FPS (as on PS4)"
    ],
    [
     "60",
     "60 FPS (game cap off)"
    ],
    [
     "unlimited",
     "Unlimited (above 60)"
    ]
   ],
   "desc": "Above 30 some scenes behave differently (the second colossus’ wall, colossi flying); use 30 there. 60 FPS needs the EU 1.01 copy."
  },
  {
   "id": "output_res",
   "tab": "Graphics",
   "label": "Output",
   "type": "choice",
   "def": "1920x1080",
   "at": [
    "app",
    "output_res"
   ],
   "options": [
    [
     "1280x720",
     "1280 × 720 (16:9, 720p)"
    ],
    [
     "1920x1080",
     "1920 × 1080 (16:9, 1080p)"
    ],
    [
     "2560x1440",
     "2560 × 1440 (16:9, 1440p)"
    ],
    [
     "3840x2160",
     "3840 × 2160 (16:9, 4K)"
    ],
    [
     "1920x1200",
     "1920 × 1200 (16:10)"
    ],
    [
     "2560x1600",
     "2560 × 1600 (16:10)"
    ],
    [
     "2560x1080",
     "2560 × 1080 (21:9)"
    ],
    [
     "3440x1440",
     "3440 × 1440 (21:9)"
    ],
    [
     "3840x1600",
     "3840 × 1600 (21:9)"
    ],
    [
     "3840x1080",
     "3840 × 1080 (32:9)"
    ],
    [
     "5120x1440",
     "5120 × 1440 (32:9)"
    ]
   ],
   "desc": "The game draws at the output size up to 1080 lines; FSR 1 scales the rest."
  },
  {
   "id": "upscaler",
   "tab": "Graphics",
   "label": "Upscaler",
   "type": "choice",
   "def": "fsr1",
   "at": [
    "app",
    "upscaler"
   ],
   "options": [
    [
     "fsr1",
     "FSR 1 (AMD, any GPU)"
    ],
    [
     "bilinear",
     "Bilinear (plain)"
    ]
   ]
  },
  {
   "id": "sharpness",
   "tab": "Graphics",
   "label": "Sharpening (RCAS)",
   "type": "choice",
   "def": "250",
   "at": [
    "app",
    "sharpness"
   ],
   "options": [
    [
     "0",
     "High"
    ],
    [
     "250",
     "Medium (default)"
    ],
    [
     "600",
     "Low"
    ],
    [
     "off",
     "Off"
    ]
   ]
  },
  {
   "id": "framegen",
   "tab": "Graphics",
   "label": "Frame generation",
   "type": "choice",
   "def": "off",
   "at": [
    "app",
    "framegen"
   ],
   "options": [
    [
     "off",
     "Off"
    ],
    [
     "auto",
     "Automatic (DLSS-G or FSR 3, experimental)"
    ],
    [
     "dlss",
     "NVIDIA DLSS-G (RTX 40/50)"
    ],
    [
     "fsr",
     "AMD FSR 3 (any GPU)"
    ]
   ],
   "desc": "Experimental, and only helps at 30 FPS. F8 in the game switches it."
  },
  {
