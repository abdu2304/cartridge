{
 "schema": 1,
 "id": "sms",
 "name": "Super Mario Sunshine (SMS Launcher)",
 "by": "chasem-dev and the Super Mario Sunshine decompilation",
 "repo": "github:chasem-dev/sms-launcher",
 "licence": "MIT",
 "about": "Super Mario Sunshine built as a native PC game from its decompiled code, on your PC from your own disc: up to 120 FPS, widescreen and ultrawide, HD textures, language packs, free camera. The launcher’s own window does the first setup (it downloads its build tools and builds the game, which takes a while); after that Cartridge starts the game straight away.",
 "verified": {
  "on": "2026-10-20",
  "release": "v0.1.63",
  "played": false
 },
 "game": {
  "console": "gamecube",
  "title": "Super Mario Sunshine",
  "ids": [
   "GMSE01"
  ],
  "kind": "file",
  "ext": [
   ".iso",
   ".gcm",
   ".ciso"
  ],
  "why": "Your own North American Super Mario Sunshine disc (GMSE01, the first release) as an ISO, GCM or CISO; Dolphin converts an RVZ to ISO."
 },
 "builds": [
  {
   "os": "linux",
   "asset": "^SMS-Launcher\\.AppImage$",
   "program": "SuperMarioSunshine(SMSLauncher).AppImage",
   "args": [
    "--no-sandbox",
    "--play"
   ],
   "files": {
    "app": {
     "path": "{config}/SMS Launcher/preferences.json",
     "format": "json",
     "nested": true
    }
   }
  }
 ],
 "app": {
  "rom": "{gamePosix}"
 },
 "setup": {
  "by": "port",
  "done": [
   "{config}/SMS Launcher/sms-pc-port/build/linux-64/sms"
  ],
  "say": "SMS Launcher builds the game in its own window the first time, in three steps: Download setup files, then your disc (Cartridge has chosen your copy already), then the setup itself, which takes a while. When it says Play, it’s done."
 },
 "settings": [
