{
  "name": "cartridge",
  "productName": "Cartridge",
  "version": "0.1.0",
  "description": "Controller-first RomM client for SteamOS and Bazzite",
  "main": "electron/main.js",
  "author": "Abdu",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:ui": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --linux AppImage --x64 --publish never",
    "release": "vite build && electron-builder --linux AppImage --x64 --publish always"
  },
  "build": {
    "appId": "xyz.abduroms.cartridge",
    "productName": "Cartridge",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json",
      "steam-art/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "Cartridge-x86_64.AppImage",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Cartridge-x86_64.AppImage"
    },
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "abdu2304",
        "repo": "cartridge",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@mdi/js": "7.4.47",
    "electron-updater": "^6.8.9",
    "socket.io-client": "^4.8.4",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "vite": "8.3.1"
  },
  "desktopName": "cartridge.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/abdu2304/cartridge.git"
  }
}
