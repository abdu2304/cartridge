{
  "name": "cartridge",
  "productName": "Cartridge",
  "version": "0.9.57",
  "versionName": "0.9.57",
  "description": "Controller-first RomM client for SteamOS and Bazzite",
  "main": "electron/main.js",
  "author": "abdu2304",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "test": "node --test test/*.test.js",
    "audit:ui": "node tools/ui-audit/run.js",
    "audit:visual": "node tools/ui-audit/visual.js",
    "build:ui": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --linux AppImage --x64 --publish never",
    "release": "vite build && electron-builder --linux AppImage --x64 --publish always"
  },
  "build": {
    "appId": "io.github.abdu2304.cartridge",
    "productName": "Cartridge",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "build/syslogos/**",
      "package.json",
      "steam-art/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "Cartridge-x86_64.AppImage",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Cartridge-x86_64.AppImage"
    },
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "abdu2304",
        "repo": "cartridge",
        "releaseType": "release"
      }
    ],
    "releaseInfo": {
      "releaseName": "Cartridge 0.9.57",
      "releaseNotesFile": "RELEASE_NOTES.md"
    }
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@mdi/js": "7.4.47",
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.3.2",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.4",
    "vue": "3.5.43",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "pdfjs-dist": "^4.10.38",
    "vite": "8.3.1"
  },
  "desktopName": "cartridge.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/abdu2304/cartridge.git"
  },
  "homepage": "https://github.com/abdu2304/cartridge"
}
